<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
    crossorigin="anonymous"
  />
  <link rel="stylesheet" href="../css/style.css"/>
</head>
<body class="d-flex flex-column min-vh-100">
    <section id="header">
        <div class="px-3 py-2 text-bg-dark border-bottom">
          <div class="container">
            <div
              class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start"
            >
              <a
                href="/"
                class="d-flex align-items-center my-2 my-lg-0 me-lg-auto text-white text-decoration-none"
              >
                <img src="/images/KW.png" height="50px" width="100px" />
              </a>
              <ul
                class="nav col-12 col-lg-auto my-2 justify-content-center my-md-0 text-small"
              >
                <li>
                  <a href="/" class="nav-link text-white">
                    <svg
                      class="bi d-block mx-auto mb-1"
                      width="24"
                      height="24"
                      aria-hidden="true"
                    ></svg>
                    Home
                  </a>
                </li>
                <li>
                  <a href="/about-me" class="nav-link text-white">
                    <svg
                      class="bi d-block mx-auto mb-1"
                      width="24"
                      height="24"
                      aria-hidden="true"
                    ></svg>
                    About Me
                  </a>
                </li>
                <li>
                  <a href="/experience" class="nav-link text-white">
                    <svg
                      class="bi d-block mx-auto mb-1"
                      width="24"
                      height="24"
                      aria-hidden="true"
                    ></svg>
                    Experience
                  </a>
                </li>
                <li>
                  <a href="/skills" class="nav-link text-white">
                    <svg
                      class="bi d-block mx-auto mb-1"
                      width="24"
                      height="24"
                      aria-hidden="true"
                    ></svg>
                    Skills
                  </a>
                </li>
                <li>
                  <a href="/contact-me" class="nav-link text-secondary">
                    <svg
                      class="bi d-block mx-auto mb-1"
                      width="24"
                      height="24"
                      aria-hidden="true"
                    >
                    </svg>
                    Contact Me
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>
        <section id="chat"  class="flex-grow-1 d-flex">
            <div class="flex-grow-1 chatFlex">
                <div class="chat-main-background" id="chatMessages">
                    <% for (let message of history) {%>
                        <% if (message.role == "user") { %>
                            <div class="chat-message-user"> 
                                <%= message.content %>     
                            </div>
                        <%} else { %>
                            <div class="chat-message-llm"> 
                                <%= message.content %>     
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </section>
        <div class="flex-user-chat">
            <div class="chat-user-input-div split card mb-3 shadow-sm rounded-4 border-0">
                <div class="py-2 text-bg-white">
                    <form id="chatForm" style="display: flex;">
                    <input
                        type="text"
                        id="chatInput"
                        class="form-control div-second-header-experience"
                        placeholder="Type a message and press Enter"
                        autocomplete="off"
                    />
                    <button class="chat-send-button">
                      Send
                    </button>
                    </form>
                 </div>
              <div class="py-2" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
                <form action="/chat-delete-history" method="post">
                  <button type="submit" class="chat-delete-button form-control"> Delete chat history</button>
                </form>
              </div>
            </div>
        </div>
        <footer class="py-2 my-2 footer mt-auto bg-light">
            <p class="text-center text-body-secondary mt-3">&copy; 2025 Kamil Wilnicki. All rights reserved.</p>
        </footer>
        <script type="module" src="/script/script-chat.js"></script>
</body>
</html>